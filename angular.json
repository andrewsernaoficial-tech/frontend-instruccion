{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "instruccionfacil": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.json",
            "styles": ["src/styles.css"],
            "assets": [{ "glob": "logo-instruccionfacil.png", "input": "src/assets", "output": "assets" }]
          },
          "configurations": { "production": { "optimization": true, "outputHashing": "all" }, "development": { "optimization": false, "sourceMap": true } },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "host": "127.0.0.1", "port": 4200, "proxyConfig": "proxy.conf.json", "buildTarget": "instruccionfacil:build:development" }
        }
      }
    }
  }
}
